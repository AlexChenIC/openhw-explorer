{
  "name": "openhw-explorer-feedback",
  "main": "index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "openhwexplorer.com/api/learning-feedback*", "zone_name": "openhwexplorer.com" },
  ],
  "send_email": [{ "name": "MAIL", "allowed_sender_addresses": ["hello@openhwexplorer.com"] }],
  "ratelimits": [
    {
      "name": "CLIENT_LIMIT",
      "namespace_id": "2026101301",
      "simple": { "limit": 10, "period": 60 },
    },
    { "name": "SITE_LIMIT", "namespace_id": "2026101302", "simple": { "limit": 30, "period": 60 } },
  ],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
}
